{% extends 'header_footer.html.twig' %}

{% block title %}Producto: {{ producto.nombre_producto }}{% endblock %}

{% block css %}
    <link rel="stylesheet" href="{{ asset('css/pagina_producto.css') }}">
{% endblock %}

{% block content %}
    <div class="producto-detalle">
        <h1>{{ producto.nombre_producto }}</h1>
        
        <div class="producto-descripcion">
            <p>{{ producto.descripcion_producto }}</p>
        </div>
        
        {% if producto.foto %}
            <div class="producto-imagen-container">
                <img src="{{ asset('images/' ~ producto.foto) }}" alt="{{ producto.nombre_producto }}" class="producto-imagen">
            </div>
        {% else %}
            <p>No hay imagen disponible.</p>
        {% endif %}

        <p id="precio">Precio: {{ producto.precio }} EUR</p>
        
        <form class="producto-form" action="{{ path('añadir_orden', { id_producto: producto.id_producto }) }}" method="post">
            <label for="cantidad">Cantidad:</label>
            <input type="number" id="cantidad" name="cantidad" value="1" min="1" required>
            <button id="añadir_carrito" type="submit">Añadir al carrito</button>
            
        </form><br>
        {% if app.session.flashBag.has('success') %}
            <div class="mensaje">
                {{ app.session.flashBag.get('success')|first }}
            </div>
        {% endif %}
    </div>
{% endblock %}
