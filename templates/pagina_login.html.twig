<!DOCTYPE html>
<html lang="es" dir="ltr">
  <head>
    <meta name="viewport" content="width=device-width, user-scalable=no, initial-scale=1.0">
    <meta charset="utf-8">
    <link rel="stylesheet" type="text/css" href="main.css">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/pagina_login.css') }}">
  </head>
  <body>
    <div class="main">
      <div class="container a-container" id="a-container">
        <form class="form" id="a-form" action="{{ path('procesar_registro') }}" method="POST">
          <h2 class="form_title title">Crear cuenta</h2>
          <span class="form__span">Usa tu correo para registrarte</span>
          <input class="form__input" type="text" placeholder="Nombre" name="usuario">
          <input class="form__input" type="text" placeholder="Apellidos" name="apellidos">
          <input class="form__input" type="text" placeholder="Dirección" name="direccion">
          <input class="form__input" type="text" placeholder="Correo" name="correo">
          <input class="form__input" type="password" placeholder="Contraseña" name="contrasena">
          <button class="form__button button_registro" type="submit" style="cursor: pointer;">REGISTRARTE</button>
          <p id="error_registro">{{ mensaje }}</p>
        </form>
      </div>
      <div class="container b-container" id="b-container">
        <form class="form" id="b-form" action="{{ path('login') }}" method="POST">
          <h2 class="form_title title">Inicia sesión</h2>
          <span class="form__span">Usa tu correo para iniciar sesión</span>
          <input class="form__input" type="text" placeholder="Correo" name="_username" id="email">
          <input class="form__input" type="password" placeholder="Contraseña" name="_password" id="contrasena" style="cursor: pointer">
          <a class="form__link" style="cursor: pointer">¿Olvidaste tu contraseña?</a>
          <p id="error_login">{{ mensaje }}</p>
          <button class="form__button button_login" type="submit" tyle="cursor: pointer;">INICIAR SESIÓN</button>
          
        </form>
      </div>
      <div class="switch" id="switch-cnt">
        <div class="switch__circle"></div>
        <div class="switch__circle switch__circle--t"></div>
        <div class="switch__container" id="switch-c1">
          <h2 class="switch__title title">¡Bienvenido!</h2>
          <p class="switch__description description">Para seguir conectado, inicia sesión, por favor.</p>
          <button class="switch__button button button_cambio switch-btn">INICIAR SESIÓN</button>
        </div>
        <div class="switch__container is-hidden" id="switch-c2">
          <h2 class="switch__title title">¡Hola!</h2>
          <p class="switch__description description">Introduce tu información para registrarte</p>
          <button class="switch__button button switch-btn">REGISTRARTE</button>
        </div>
      </div>
    </div>
    <script src="main.js"></script>
  </body>
</html>
<!-- partial -->
  <script src="{{ asset('js/script_login.js') }}"></script>

</body>
</html>
